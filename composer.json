{
    "name": "codered/php-8-5-workshop",
    "description": "Hands-on exercises for the PHP features introduced in 8.2 to 8.5",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Workshop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workshop\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:solutions": [
            "@putenv WORKSHOP_SOLUTIONS=1",
            "phpunit"
        ]
    }
}
